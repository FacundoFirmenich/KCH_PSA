{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/FacundoFirmenich/KCH_PSA/schemas/process-supervisor-witness.schema.json",
  "title": "KCH PSA process supervisor host-real witness",
  "oneOf": [
    {"$ref": "#/$defs/passReceipt"},
    {"$ref": "#/$defs/failReceipt"}
  ],
  "$defs": {
    "processIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "pid", "executable_path", "executable_sha256", "start_token"],
      "properties": {
        "schema": {"const": "kch-psa.process-identity.v0.1.0"},
        "pid": {"type": "integer", "minimum": 1},
        "executable_path": {"type": "string", "minLength": 1},
        "executable_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "start_token": {"type": "string", "minLength": 1}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bytes": {"type": "integer", "minimum": 0}
      }
    },
    "passReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "witness_id",
        "status",
        "started_at",
        "ended_at",
        "platform",
        "python",
        "process_identity",
        "run_expires_at",
        "exit_code",
        "lifecycle_phase",
        "ledger_event_count",
        "ledger_head",
        "artifacts",
        "evidence_boundaries"
      ],
      "properties": {
        "schema": {"const": "kch-psa.process-supervisor-witness.v0.1.0"},
        "witness_id": {"type": "string", "format": "uuid"},
        "status": {"const": "PASS"},
        "started_at": {"type": "string", "format": "date-time"},
        "ended_at": {"type": "string", "format": "date-time"},
        "platform": {"type": "string", "minLength": 1},
        "python": {"type": "string", "minLength": 1},
        "process_identity": {"$ref": "#/$defs/processIdentity"},
        "run_expires_at": {"type": "string", "format": "date-time"},
        "exit_code": {"type": "integer"},
        "lifecycle_phase": {"const": "STOPPED"},
        "ledger_event_count": {"type": "integer", "minimum": 4},
        "ledger_head": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "artifacts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ledger", "process_record", "stdout", "stderr"],
          "properties": {
            "ledger": {"$ref": "#/$defs/artifact"},
            "process_record": {"$ref": "#/$defs/artifact"},
            "stdout": {"$ref": "#/$defs/artifact"},
            "stderr": {"$ref": "#/$defs/artifact"}
          }
        },
        "evidence_boundaries": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "failReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "witness_id", "status", "started_at", "ended_at", "error_type", "error"],
      "properties": {
        "schema": {"const": "kch-psa.process-supervisor-witness.v0.1.0"},
        "witness_id": {"type": "string", "format": "uuid"},
        "status": {"const": "FAIL"},
        "started_at": {"type": "string", "format": "date-time"},
        "ended_at": {"type": "string", "format": "date-time"},
        "error_type": {"type": "string", "minLength": 1},
        "error": {"type": "string", "minLength": 1}
      }
    }
  }
}
